# Copia este archivo a ".env.local" (en tu máquina) o configura estas
# mismas variables en Vercel → Settings → Environment Variables.
# NUNCA subas el archivo .env.local a GitHub (ya está excluido en .gitignore).

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Opcional — solo si tu cuenta de Zoho no es del dominio .com
# (por ejemplo .eu, .in, .com.au). Si no sabes, déjalo así:
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
